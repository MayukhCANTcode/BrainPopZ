# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Client ID for Backend Audience Verification
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Session Secret for Cryptographic Cookie Verification
SESSION_SECRET=your_random_strong_session_secret_min_32_characters
